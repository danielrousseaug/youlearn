# ===== YouLearn Project .gitignore =====

# Environment Variables
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
!.env.example

# ===== Frontend (Next.js) =====
# Dependencies
node_modules/
frontend/node_modules/

# Build outputs
.next/
frontend/.next/
out/
frontend/out/

# Build cache
.cache/
.parcel-cache/

# TypeScript cache
*.tsbuildinfo
frontend/*.tsbuildinfo

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# ===== Backend (Python) =====
# Python cache
__pycache__/
backend/__pycache__/
*.py[cod]
*$py.class

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual environments
venv/
env/
ENV/
backend/venv/
backend/env/

# Uploaded files (keep the directory structure but not the files)
backend/uploads/*
!backend/uploads/.gitkeep

# ===== Development Tools =====
# IDEs
.vscode/
.idea/
*.swp
*.swo
*~

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Testing
coverage/
*.lcov
.nyc_output
.coverage
htmlcov/
.pytest_cache/

# ESLint cache
.eslintcache

# ===== Production & Deployment =====
# Docker
Dockerfile.prod
docker-compose.prod.yml

# Logs
logs/
*.log

# ===== Temporary Files =====
# Temporary files
tmp/
temp/
.tmp/

# Backup files
*.bak
*.backup
*.orig

# ===== Security =====
# Secrets
secrets/
*.pem
*.key
!public.key

# API keys (additional safety)
*api*key*
*secret*
!*example*